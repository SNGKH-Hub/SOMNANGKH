local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

local Button = Tab:Button({
    Title = "Tween TP to Specks (Fast)",
    Desc = "Smooth & fast tween teleport to player 'Specks' (bypass attempt)",
    Locked = false,
    Callback = function()
        -- Find the target player (case-insensitive check on Name or DisplayName)
        local targetName = "Specks"
        local targetPlayer = nil
        
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Name:lower() == targetName:lower() or (plr.DisplayName and plr.DisplayName:lower() == targetName:lower()) then
                targetPlayer = plr
                break
            end
        end
        
        if not targetPlayer then
            warn("Player '" .. targetName .. "' not found!")
            -- Optional: add a notification if your UI lib supports it
            -- Library:Notify("Player not found!", 3)
            return
        end
        
        local targetChar = targetPlayer.Character
        if not targetChar then
            warn("Target has no character loaded")
            return
        end
        
        local targetHRP = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso")
        if not targetHRP then
            warn("Target has no valid root part")
            return
        end
        
        local myChar = LocalPlayer.Character
        if not myChar then
            warn("You have no character")
            return
        end
        
        local myHRP = myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then
            warn("No HumanoidRootPart found")
            return
        end
        
        -- Make sure character is loaded properly
        if myHRP.Anchored then
            warn("Your HRP is anchored - cannot tween")
            return
        end
        
        -- Calculate target position (slightly above & offset to avoid clipping inside)
        local targetPos = targetHRP.Position + Vector3.new(0, 4, 0)  -- 4 studs above
        -- Optional: face the target player → targetHRP.CFrame * CFrame.new(0,0,-3)
        -- local goalCFrame = CFrame.new(targetPos, targetHRP.Position)
        
        local goalCFrame = CFrame.new(targetPos)
        
        -- Fast tween settings (adjust time for speed)
        -- 0.35–0.6 sec usually feels "fast but not instant" → many anticheats allow this range
        local tweenInfo = TweenInfo.new(
            0.4,                        -- Duration (lower = faster, but riskier for detection)
            Enum.EasingStyle.Linear,    -- Linear = constant speed (most bypass-friendly)
            Enum.EasingDirection.Out,   -- Not super important with Linear
            0,                          -- Repeat count
            false,                      -- Reverses?
            0                           -- Delay
        )
        
        -- Create and play the tween
        local tween = TweenService:Create(myHRP, tweenInfo, {CFrame = goalCFrame})
        
        -- Optional: tiny upward boost at start (helps in some games with floor checks)
        -- myHRP.Velocity = Vector3.new(0, 20, 0)
        
        tween:Play()
        
        -- Optional: listen for completion or cancellation
        tween.Completed:Connect(function(playbackState)
            if playbackState == Enum.PlaybackState.Completed then
                print("Tween TP to " .. targetPlayer.Name .. " completed!")
            elseif playbackState == Enum.PlaybackState.Cancelled then
                print("Tween was cancelled")
            end
        end)
        
        print("Tween teleport started to " .. targetPlayer.Name)
    end
})
