local Window = Library:CreateWindow({
    Title = "SB2K Hub",
    Desc = "",
    Author = " By SOMNANGB2K",
    WindowColor = "Green",
})

local Tab = Window:Tab({
    Title = "General",
    Locked = false,
})

local Section = Tab:Section({ 
    Title = "Test" 
})

local Toggle = Section:Toggle({
    Title = "Auto Wins (SUPER FAST)",
    Desc = "Ultra Speed",
    Value = false,
    Callback = function(state)
        _G.TP_Loop = state

        if state then
            task.spawn(function()
                local player = game.Players.LocalPlayer

                while _G.TP_Loop do
                    local char = player.Character or player.CharacterAdded:Wait()
                    local hrp = char:FindFirstChild("HumanoidRootPart")

                    local stage = workspace:FindFirstChild("Buttons")
                        and workspace.Buttons:FindFirstChild("Button16")

                    if hrp and stage then
                        -- ⚡ STEP 1: CENTER (Model or Part)
                        hrp.CFrame = (stage.PrimaryPart and stage.PrimaryPart.CFrame or stage:GetPivot()) + Vector3.new(0,5,0)

                        -- ⚡ STEP 2: HEAD (if exists)
                        local head = stage:FindFirstChild("Head")
                        if head then
                            hrp.CFrame = head.CFrame + Vector3.new(0,3,0)
                        end

                        -- ⚡ STEP 3: PART (important trigger)
                        local part = stage:FindFirstChild("Part")
                        if part then
                            hrp.CFrame = part.CFrame + Vector3.new(0,3,0)
                        end
                    end

                    task.wait(0.05) -- 🔥 same ultra speed
                end
            end)
        end
    end
})
